M99_APP_NAME=M99 Knowledge Platform
M99_ENV=development
M99_HOST=127.0.0.1
M99_PORT=8070
M99_DATABASE_URL=sqlite:///./data/m99_admin.db
M99_SESSION_SECRET=CHANGE_ME_GENERATE_LOCALLY
M99_SESSION_HTTPS_ONLY=false
M99_SESSION_MAX_AGE=28800

# m99.eu WooCommerce sandbox API
# REAL VALUES belong only in .env.local (Git-ignored).
M99EU_BASE_URL=https://m99.eu
M99EU_API_PATH=/wp-json/wc/v3
M99EU_WC_CONSUMER_KEY=ck_REPLACE_LOCALLY
M99EU_WC_CONSUMER_SECRET=cs_REPLACE_LOCALLY
M99EU_TIMEOUT_SECONDS=20

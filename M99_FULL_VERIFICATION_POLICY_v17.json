{
  "schema": "m99.policy.full_verification.v1",
  "policy_id": "M99-FULL-TEST-SIMULATION-RULE",
  "version": "17.0",
  "status": "NORMATIVE_MANDATORY",
  "default_behavior": "FAIL_CLOSED",

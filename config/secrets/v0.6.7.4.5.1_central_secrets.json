{
  "schema_version": "0.6.7.4.5.1",
  "mode": "M99_CENTRAL_SECRETS_ARCHITECTURE",
  "provider": "HASHICORP_VAULT_HTTP_API",
  "secret_mount": "secret",
  "secret_prefix": "m99/channels",
  "auth": {
    "method": "token",
    "runtime_env": "M99_VAULT_TOKEN",
    "address_env": "M99_VAULT_ADDR",
    "namespace_env": "M99_VAULT_NAMESPACE"
  },
  "policy": {
    "secrets_in_repo": false,
    "plaintext_local_secret_files": false,
    "logs_must_redact": true,
    "credentials_persisted_by_m99": false,
    "central_rotation_supported": true,
    "multi_computer_supported": true,
    "machine_access_revocable": true
  },
  "channels": {
    "mela99.com": {
      "secret_path": "m99/channels/mela99.com",
      "fields": [
        "api_key"
      ]
    },
    "m99.eu": {
      "secret_path": "m99/channels/m99.eu",
      "fields": [
        "username",
        "app_password"
      ]
    },
    "rabotni-drehi.com": {
      "secret_path": "m99/channels/rabotni-drehi.com",
      "fields": [
        "username",
        "app_password"
      ]
    },
    "medicinski-drehi.com": {
      "secret_path": "m99/channels/medicinski-drehi.com",
      "fields": [
        "api_key"
      ]
    },
    "laviro.ro": {
      "secret_path": "m99/channels/laviro.ro",
      "fields": [
        "api_key"
      ]
    },
    "alviro.ro": {
      "secret_path": "m99/channels/alviro.ro",
      "fields": [
        "api_key"
      ]
    }
  }
}
